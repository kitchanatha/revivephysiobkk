doctype html
html(lang='en')

    head

        -
            const siteUrl = 'https://revivephysiobkk.com'
            const ogImage = siteUrl + '/assets/img/pilates.jpg'
            const lineId = contact.line.startsWith('@') ? contact.line.slice(1) : contact.line
            const instaId = contact.instagram.startsWith('@') ? contact.instagram.slice(1) : contact.instagram
            const lineHref = `https://line.me/R/ti/p/%40${lineId}`
            const instaHref = `https://www.instagram.com/${instaId}`
            const telHref = `tel:${contact.phone.replace(/[^\d+]/g, '')}`
            const mapEmbedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(location.address)}&z=16&output=embed`
            const mapLinkHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.address)}`
            const schema = {
                '@context': 'https://schema.org',
                '@type': 'MedicalClinic',
                name: 'Revive Physio Clinic',
                url: siteUrl,
                image: ogImage,
                telephone: contact.phone,
                email: contact.email,
                medicalSpecialty: 'Physiotherapy',
                address: {
                    '@type': 'PostalAddress',
                    streetAddress: location.address,
                    addressLocality: 'Bangkok',
                    addressCountry: 'TH'
                },
                // Recovered from the last archived version of the old site
                // (Jan 2025) — confirm these are still accurate before relying
                // on them; update src/data/site.json + here if hours change.
                openingHoursSpecification: [
                    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '19:00' },
                    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday', 'Sunday'], opens: '08:00', closes: '18:00' }
                ],
                sameAs: [instaHref, lineHref],
                description: meta.description
            }

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content=meta.description)

        title= meta.title

        link(rel='canonical', href=siteUrl)

        // Open Graph / social sharing
        meta(property='og:type', content='website')
        meta(property='og:site_name', content='Revive Physio Clinic')
        meta(property='og:title', content=meta.title)
        meta(property='og:description', content=meta.description)
        meta(property='og:url', content=siteUrl)
        meta(property='og:image', content=ogImage)
        meta(property='og:locale', content=meta.ogLocale)
        meta(name='twitter:card', content='summary_large_image')
        meta(name='twitter:title', content=meta.title)
        meta(name='twitter:description', content=meta.description)
        meta(name='twitter:image', content=ogImage)

        // MedicalClinic structured data.
        script(type='application/ld+json')!= JSON.stringify(schema)

        // Favicon
        link(rel='icon', type='image/png', href='/assets/img/logo.png')

        // Font Awesome icons (free version)
        script(src='https://use.fontawesome.com/releases/v6.3.0/js/all.js', crossorigin='anonymous')

        // Google fonts
        link(href='https://fonts.googleapis.com/css?family=Montserrat:400,700', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700', rel='stylesheet', type='text/css')

        // Core theme CSS (includes Bootstrap)
        link(href='/css/styles.css', rel='stylesheet')

    body#page-top

        // Navigation
        nav#mainNav.navbar.navbar-expand-lg.navbar-dark.fixed-top
            .container
                a.navbar-brand(href='#page-top') Revive Physio Clinic
                button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    | Menu
                    i.fas.fa-bars.ms-1
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.text-uppercase.ms-auto.py-4.py-lg-0
                        li.nav-item
                            a.nav-link(href='#services') Services
                        li.nav-item
                            a.nav-link(href='#gallery') Gallery
                        li.nav-item
                            a.nav-link(href='#contact') Location
                        li.nav-item.ms-lg-2.mt-2.mt-lg-0
                            a.btn.btn-sm.btn-outline-light(href=telHref, aria-label=`Call ${contact.phone}`)
                                i.fas.fa-phone.me-1
                                span.d-lg-none= contact.phone
                        li.nav-item.ms-lg-2.mt-2.mt-lg-0
                            a.btn.btn-sm.btn-success(href=lineHref, target='_blank', aria-label='Chat with Revive Physio Clinic on LINE')
                                i.fab.fa-line.me-1
                                | LINE

        // Masthead
        header.masthead
            .container
                .masthead-inner
                    p.masthead-eyebrow= hero.eyebrow
                    h1.masthead-heading= hero.h1
                    p.masthead-subheading= hero.sub
                    .mt-4
                        a.btn.btn-primary.btn-xl.text-uppercase.me-2.mb-2(href=lineHref, target='_blank')= hero.ctaPrimary
                        a.btn.btn-outline-light.btn-xl.text-uppercase.mb-2(href=telHref)= hero.ctaSecondary

        // Our Strength
        section#strength.page-section
            .container.text-center
                h2.section-heading.text-uppercase= strength.heading
                p.lead= strength.text

        // Services
        section#services.page-section.bg-light
            .container
                .text-center
                    h2.section-heading.text-uppercase Our Services
                .row.text-center.justify-content-center
                    each service in services
                        .col-md-5
                            span.fa-stack.fa-4x
                                i.fas.fa-circle.fa-stack-2x.text-primary
                                i.fas.fa-star.fa-stack-1x.fa-inverse
                            h4.my-3= service.title
                            p.text-muted= service.desc

        // Pilates types
        section#pilates-types.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase 4 Private Pilates Services
                .row.text-center
                    each type in pilatesTypes
                        .col-md-3.mb-4
                            h4.my-3= type.title
                            p.text-muted= type.desc

        // Trial offer callout
        section#offer.page-section.bg-light
            .container
                .offer-box
                    h3.text-uppercase= offer.title
                    p.offer-desc= offer.desc
                    p.offer-note= offer.note
                    a.btn.btn-primary.btn-xl.text-uppercase(href=lineHref, target='_blank')= offer.cta

        // Gallery
        section#gallery.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Gallery
                .row
                    each photo in gallery
                        .col-lg-4.col-sm-6.mb-4
                            .portfolio-item
                                a.portfolio-link(href=`/assets/img/${photo.file}`, target='_blank', title='Open full image in new tab')
                                    .portfolio-hover
                                        .portfolio-hover-content
                                            | Click or hover to enlarge
                                    img.img-fluid(src=`/assets/img/${photo.file}`, alt=photo.alt)

        // Location + Contact
        section#contact.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase= location.heading
                .map-container.mt-4
                    iframe(src=mapEmbedSrc, allowfullscreen='', loading='lazy')
                .text-center.mt-3
                    a.text-white.d-inline-block(href=mapLinkHref, target='_blank') Open in Google Maps
                .row.mt-4
                    .col-lg-12.text-center
                        p= location.address
                        each slot in location.hours
                            p.mb-0
                                strong= slot.days
                                | : #{slot.time}
                        p.fst-italic.mt-2= location.hoursNote
                        p.mt-4= contact.phone
                        p
                            a(href=`mailto:${contact.email}`)= contact.email
                        p.mb-1
                            a.d-inline-flex.align-items-center.text-white(href=lineHref, target='_blank')
                                i.fab.fa-line.me-2
                                | #{contact.line}
                        p.mb-1
                            a.d-inline-flex.align-items-center.text-white(href=instaHref, target='_blank')
                                i.fab.fa-instagram.me-2
                                | #{contact.instagram}

        // Footer
        footer.footer.py-4
            .container
                .row.align-items-center
                    .col-lg-6.text-lg-start
                        | Copyright &copy; Revive Physio Clinic 2026
                    .col-lg-6.text-lg-end
                        a.btn.btn-dark.btn-social.mx-2(href=lineHref, aria-label='Line', target='_blank')
                            i.fab.fa-line
                        a.btn.btn-dark.btn-social.mx-2(href=contact.facebook, aria-label='Facebook', target='_blank')
                            i.fab.fa-facebook-f
                        a.btn.btn-dark.btn-social.mx-2(href=instaHref, aria-label='Instagram', target='_blank')
                            i.fab.fa-instagram

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        // Core theme JS
        script(src='/js/scripts.js')
