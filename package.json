{
    "title": "Revive Physio Clinic",
    "name": "revivephysiobkk",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "npm run clean && npm run build:pug && npm run build:scss && npm run build:scripts && npm run build:assets && npm run build:seo",
        "build:assets": "node scripts/build-assets.js",
        "build:pug": "node scripts/build-pug.js",
        "build:scripts": "node scripts/build-scripts.js",
        "build:scss": "node scripts/build-scss.js",
        "build:seo": "node scripts/build-seo-files.js",
        "clean": "node scripts/clean.js",
        "start": "npm run build && node scripts/start.js"
    },
    "description": "Website for Revive Physio Clinic, a physiotherapy and private Pilates clinic at Hub 24, Ramkhamhaeng, Bangkok.",
    "homepage": "https://revivephysiobkk.com",
    "license": "MIT",
    "repository": {
        "type": "git",
